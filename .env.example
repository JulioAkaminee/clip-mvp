OPENROUTER_API_KEY=

# Modelos OpenRouter (SPEC §4). Slugs configuráveis; confirme disponibilidade
# no catálogo da OpenRouter no momento do uso.
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_CANDIDATE_MODEL=google/gemini-2.5-flash
OPENROUTER_SCORE_MODEL=google/gemini-2.5-flash
OPENROUTER_META_MODEL=google/gemini-2.5-flash

# Regras de fronteira de corte (SPEC §2.5 / §14.1): nunca cortar no meio de
# palavra; folga de 200-400ms antes/depois do corte.
CLIP_PAD_MS_MIN=200
CLIP_PAD_MS_MAX=400

# Duração máxima do vertical 9:16 em segundos (SPEC §2).
CLIP_VERTICAL_MAX_S=90

# Limiar mínimo de score para um clip ser exportado (SPEC §3, §8).
CLIP_MIN_SCORE=60

# Estimativas de custo OpenRouter (USD) para --dry-run / --budget (SPEC §14.4).
# Apenas para estimativa local, não refletem cobrança real da OpenRouter.
CLIP_COST_STT_USD_PER_MIN=0.006
CLIP_COST_TEXT_USD_PER_CANDIDATE=0.001
CLIP_COST_VISION_USD_PER_FRAME=0.003
CLIP_FRAMES_PER_SCORE=3

# Diretórios de trabalho/saída (SPEC §5).
CLIP_WORK_DIR=work
CLIP_OUT_DIR=out

# Altura máxima de download (SPEC §6: 720p, Mac i5 16GB friendly).
CLIP_DOWNLOAD_HEIGHT=720

# Nº de exemplos recentes de feedback injetados como few-shot (SPEC §14.7).
CLIP_FEEDBACK_EXAMPLES_N=6
