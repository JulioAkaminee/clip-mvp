OPENROUTER_API_KEY=

# Modelos OpenRouter (SPEC §4). Slugs configuráveis; confirme disponibilidade
# no catálogo da OpenRouter no momento do uso. A interface (Configurações)
# sobrepõe estes valores quando o usuário escolhe outro modelo ou cola a chave
# lá — o arquivo fica em ~/.config/clip-mvp/settings.json (ou CLIP_SETTINGS_FILE).
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_CANDIDATE_MODEL=google/gemini-2.5-flash
OPENROUTER_SCORE_MODEL=google/gemini-2.5-flash
OPENROUTER_META_MODEL=google/gemini-2.5-flash
# Vazio = usa o modelo de STT. Só preencha se o diarizador for outro slug.
OPENROUTER_DIARIZATION_MODEL=

# Arquivo de settings da UI. Sem isso, o default é ~/.config/clip-mvp/settings.json
# (fora do repositório, para a chave não ir parar num commit).
# CLIP_SETTINGS_FILE=

# Regras de fronteira de corte (SPEC §2.5 / §14.1): nunca cortar no meio de
# palavra; folga de 200-400ms antes/depois do corte.
CLIP_PAD_MS_MIN=200
CLIP_PAD_MS_MAX=400

# Duração máxima do vertical 9:16 em segundos (SPEC §2).
CLIP_VERTICAL_MAX_S=90

# 9:16: mínimo 45s, máximo 90s. Abaixo disso o vertical é descartado.
CLIP_VERTICAL_MIN_S=45
CLIP_VERTICAL_MIN_SHRUNK_S=45
# 16:9: mínimo 60s; a IA escolhe o restante do tamanho.
CLIP_HORIZONTAL_MIN_S=60

# Limiar mínimo de score para um clip ser exportado (SPEC §3, §8).
CLIP_MIN_SCORE=60

# Piso relativo da seleção (SPEC §3.5): distância máxima entre o melhor corte do
# job e o pior que ainda vale entregar. O limiar acima diz "é publicável?"; este
# diz "presta ao lado do resto deste vídeo?". 0 desliga a regra.
CLIP_SCORE_RELATIVE_GAP=22

# Estimativas de custo OpenRouter (USD) para --dry-run / --budget (SPEC §14.4).
# Apenas para estimativa local, não refletem cobrança real da OpenRouter.
CLIP_COST_STT_USD_PER_MIN=0.006
CLIP_COST_TEXT_USD_PER_CANDIDATE=0.001
CLIP_COST_VISION_USD_PER_FRAME=0.003
CLIP_FRAMES_PER_SCORE=3

# Diretórios de trabalho/saída (SPEC §5).
CLIP_WORK_DIR=work
CLIP_OUT_DIR=out

# Altura máxima de download (Full HD).
CLIP_DOWNLOAD_HEIGHT=1080

# Taxa de quadros da saída. 30 é o que TikTok/Reels/Shorts entregam na maioria
# dos aparelhos, e cabeça falando não tem movimento que 30 não resolva.
# Renderizar em 60 dobra os quadros que passam por crop, escala e encoder:
# medido, cair para 30 tira ~38% do tempo de render. Suba para 60 só se o corte
# tiver movimento rápido.
CLIP_OUTPUT_FPS=30

# O áudio exportado é sempre reamostrado para 48 kHz (audio.OUTPUT_SAMPLE_RATE).
# Não é configurável de propósito: o loudnorm reamostra para 192 kHz por dentro
# e qualquer valor acima de 48 kHz gera um AAC que nenhum navegador decodifica.

# Nº de exemplos recentes de feedback injetados como few-shot (SPEC §14.7).
CLIP_FEEDBACK_EXAMPLES_N=6

# Batimento do progresso (segundos): de quanto em quanto tempo reemitir o
# snapshot enquanto o job roda, para o ETA andar dentro de estágios que são uma
# única chamada bloqueante (um prompt, um ffmpeg). 0 desliga.
CLIP_PROGRESS_HEARTBEAT_S=2

# Paralelismo. Rede paraleliza bem; ffmpeg e MediaPipe competem por CPU/RAM e
# subir demais faz o i5 entrar em swap.
CLIP_NETWORK_WORKERS=3
CLIP_RENDER_WORKERS=2
# Cookies do YouTube (para resolver "Sign in to confirm you're not a bot").
# Opção 1: ler direto do navegador (safari, chrome, firefox, edge, brave)
# CLIP_YTDLP_COOKIES_FROM_BROWSER=chrome
# Opção 2: apontar arquivo exportado (Netscape cookies.txt)
# CLIP_YTDLP_COOKIE_FILE=
#
# Forçar um player client do YouTube. Deixe VAZIO: o padrão do yt-dlp é o que
# devolve os formatos até 1080p. Fixar "web"/"mweb" aqui faz o YouTube entregar
# só o formato 18 (360p) e todo corte sai de 360p.
# CLIP_YTDLP_PLAYER_CLIENT=

